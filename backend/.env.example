PORT=5000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/admission_helpdesk?schema=public"

# Frontend address (allowed by CORS)
CLIENT_URL=http://localhost:5173

# How long a login token stays valid
TOKEN_TTL_HOURS=24

# Admin account created by the seed script
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=

# Minimum similarity needed to answer (otherwise the question goes to the admin)
SIMILARITY_THRESHOLD=0.4
